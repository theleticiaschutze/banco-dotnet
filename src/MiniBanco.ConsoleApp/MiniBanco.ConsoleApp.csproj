<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Desativado de propósito: o projeto NÃO pode usar LINQ (RF09) e o ImplicitUsings importaria System.Linq. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MiniBanco.ConsoleApp</RootNamespace>
  </PropertyGroup>

</Project>
